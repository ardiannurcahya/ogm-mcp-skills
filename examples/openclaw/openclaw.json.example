{
  "mcpServers": {
    "ogm": {
      "command": "uvx",
      "args": ["ogm-mcp-skills==0.2.2"],
      "env": {
        "OGM_BASE_URL": "${OGM_BASE_URL}",
        "OGM_API_KEY": "${OGM_API_KEY}",
        "OGM_PROJECT_ID": "${OGM_PROJECT_ID}",
        "OGM_PERMISSION_PROFILE": "${OGM_PERMISSION_PROFILE}"
      }
    }
  },
  "instructions": "When investigating bugs, searching codebase structure, or answering technical questions, use OpenGraphMemory tools (`ogm_*`). Always call `ogm_recall_code_memory` before attempting a code fix, and call `ogm_record_code_fix` upon successful resolution."
}
